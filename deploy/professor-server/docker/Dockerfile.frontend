FROM node:22-slim AS build

WORKDIR /app/hedge-front
COPY hedge-front/package.json hedge-front/package-lock.json ./
RUN npm ci
COPY hedge-front ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/professor-server/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/hedge-front/dist /usr/share/nginx/html
